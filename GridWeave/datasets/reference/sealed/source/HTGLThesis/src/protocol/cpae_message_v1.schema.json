{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pae.local/schema/cpae-message/v1",
  "title": "Consensus-independent C-PaE protocol message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "protocol_version", "model_version", "message_id", "message_type", "sender", "recipients", "sequence_number", "nonce", "claimed_event_time", "emitted_at", "received_at", "body_digest", "previous_message_digest", "signature", "delivery_state", "body"],
  "properties": {
    "schema_id": {"const": "https://pae.local/schema/cpae-message/v1"},
    "protocol_version": {"const": "C-PAE-1.0.0"},
    "model_version": {"const": "PAE-FECM-v1.0.0"},
    "message_id": {"$ref": "#/$defs/Id"},
    "message_type": {"enum": ["CASE_SUBMIT", "CASE_ACCEPT", "SCOPE_DECLARE", "SCOPE_COMMIT", "LINEAGE_DISCLOSE", "OBLIGATION_ASSIGN", "ERASURE_COMMAND", "TERMINAL_RECEIPT", "EXCEPTION_ASSERT", "EVIDENCE_ANCHOR", "VIEW_COMMIT", "CHALLENGE_OPEN", "CHALLENGE_RESOLVE", "CLOSURE_QUERY", "CLOSURE_DECISION", "EVIDENCE_VALIDATION", "DISPUTE_OPEN", "DISPUTE_RESOLVE", "EXCEPTION_DECISION", "AUDIT_QUERY", "AUDIT_RESPONSE"]},
    "sender": {"$ref": "#/$defs/Sender"},
    "recipients": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
    "sequence_number": {"type": "integer", "minimum": 0},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32,128}$"},
    "claimed_event_time": {"$ref": "#/$defs/Timestamp"},
    "emitted_at": {"$ref": "#/$defs/Timestamp"},
    "received_at": {"oneOf": [{"$ref": "#/$defs/Timestamp"}, {"type": "null"}]},
    "body_digest": {"$ref": "#/$defs/Digest"},
    "previous_message_digest": {"oneOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]},
    "signature": {"$ref": "#/$defs/Signature"},
    "delivery_state": {"enum": ["CREATED", "IN_FLIGHT", "DELIVERED", "DROPPED", "QUARANTINED"]},
    "body": {"type": "object"}
  },
  "allOf": [
    {"if":{"properties":{"message_type":{"const":"CASE_SUBMIT"}}},"then":{"properties":{"body":{"$ref":"#/$defs/CaseSubmit"}}}},
    {"if":{"properties":{"message_type":{"const":"CASE_ACCEPT"}}},"then":{"properties":{"body":{"$ref":"#/$defs/CaseAccept"}}}},
    {"if":{"properties":{"message_type":{"const":"SCOPE_DECLARE"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ScopeDeclare"}}}},
    {"if":{"properties":{"message_type":{"const":"SCOPE_COMMIT"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ScopeCommit"}}}},
    {"if":{"properties":{"message_type":{"const":"LINEAGE_DISCLOSE"}}},"then":{"properties":{"body":{"$ref":"#/$defs/LineageDisclose"}}}},
    {"if":{"properties":{"message_type":{"const":"OBLIGATION_ASSIGN"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ObligationAssign"}}}},
    {"if":{"properties":{"message_type":{"const":"ERASURE_COMMAND"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ErasureCommand"}}}},
    {"if":{"properties":{"message_type":{"const":"TERMINAL_RECEIPT"}}},"then":{"properties":{"body":{"$ref":"#/$defs/TerminalReceipt"}}}},
    {"if":{"properties":{"message_type":{"const":"EXCEPTION_ASSERT"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ExceptionAssert"}}}},
    {"if":{"properties":{"message_type":{"const":"EVIDENCE_ANCHOR"}}},"then":{"properties":{"body":{"$ref":"#/$defs/EvidenceAnchor"}}}},
    {"if":{"properties":{"message_type":{"const":"VIEW_COMMIT"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ViewCommit"}}}},
    {"if":{"properties":{"message_type":{"const":"CHALLENGE_OPEN"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ChallengeOpen"}}}},
    {"if":{"properties":{"message_type":{"const":"CHALLENGE_RESOLVE"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ChallengeResolve"}}}},
    {"if":{"properties":{"message_type":{"const":"CLOSURE_QUERY"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ClosureQuery"}}}},
    {"if":{"properties":{"message_type":{"const":"CLOSURE_DECISION"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ClosureDecision"}}}},
    {"if":{"properties":{"message_type":{"const":"EVIDENCE_VALIDATION"}}},"then":{"properties":{"body":{"$ref":"#/$defs/EvidenceValidation"}}}},
    {"if":{"properties":{"message_type":{"const":"DISPUTE_OPEN"}}},"then":{"properties":{"body":{"$ref":"#/$defs/DisputeOpen"}}}},
    {"if":{"properties":{"message_type":{"const":"DISPUTE_RESOLVE"}}},"then":{"properties":{"body":{"$ref":"#/$defs/DisputeResolve"}}}},
    {"if":{"properties":{"message_type":{"const":"EXCEPTION_DECISION"}}},"then":{"properties":{"body":{"$ref":"#/$defs/ExceptionDecision"}}}},
    {"if":{"properties":{"message_type":{"const":"AUDIT_QUERY"}}},"then":{"properties":{"body":{"$ref":"#/$defs/AuditQuery"}}}},
    {"if":{"properties":{"message_type":{"const":"AUDIT_RESPONSE"}}},"then":{"properties":{"body":{"$ref":"#/$defs/AuditResponse"}}}}
  ],
  "$defs": {
    "Id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{2,127}$"},
    "IdArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
    "Timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Grade": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "Disposition": {"enum": ["ERASED", "CRYPTO_ERASED", "APPROVED_TRANSFORM", "FAILED", "REFUSED", "UNREACHABLE"]},
    "Outcome": {"enum": ["CLOSED", "CLOSED_WITH_EXCEPTIONS", "PARTIALLY_CLOSED", "OPEN", "DISPUTED", "UNVERIFIABLE", "IN_PROGRESS"]},
    "Sender": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_id", "organization_id", "role", "key_id"],
      "properties": {
        "principal_id": {"$ref": "#/$defs/Id"}, "organization_id": {"$ref": "#/$defs/Id"},
        "role": {"enum": ["REQUESTER", "CONTROLLER", "PROCESSOR", "CUSTODIAN", "REPOSITORY_OPERATOR", "CASE_COORDINATOR", "AUDITOR", "VALIDATOR", "OBSERVER", "EXCEPTION_AUTHORITY", "EVALUATOR"]},
        "key_id": {"$ref": "#/$defs/Id"}
      }
    },
    "Signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "domain", "value"],
      "properties": {
        "algorithm": {"enum": ["Ed25519", "ECDSA-P256-SHA256", "RSA-PSS-SHA256"]},
        "canonicalization": {"const": "RFC8785-JCS"},
        "domain": {"const": "C-PAE-MESSAGE-v1"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,2048}$"}
      }
    },
    "CaseSubmit": {"type":"object","additionalProperties":false,"required":["case_id","request_ref","root_asset_refs","policy_profile_ref","authorization_ref","lineage_snapshot_time","requested_deadline"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"request_ref":{"$ref":"#/$defs/Id"},"root_asset_refs":{"$ref":"#/$defs/IdArray"},"policy_profile_ref":{"$ref":"#/$defs/Id"},"authorization_ref":{"$ref":"#/$defs/Id"},"lineage_snapshot_time":{"$ref":"#/$defs/Timestamp"},"requested_deadline":{"$ref":"#/$defs/Timestamp"}}},
    "CaseAccept": {"type":"object","additionalProperties":false,"required":["case_id","request_ref","policy_profile_ref","accepted_at","evaluation_deadline","acceptance_commitment"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"request_ref":{"$ref":"#/$defs/Id"},"policy_profile_ref":{"$ref":"#/$defs/Id"},"accepted_at":{"$ref":"#/$defs/Timestamp"},"evaluation_deadline":{"$ref":"#/$defs/Timestamp"},"acceptance_commitment":{"$ref":"#/$defs/Digest"}}},
    "ScopeDeclare": {"type":"object","additionalProperties":false,"required":["case_id","scope_version","relationship_refs","replica_refs","predecessor_scope_commitment"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"scope_version":{"type":"integer","minimum":1},"relationship_refs":{"$ref":"#/$defs/IdArray"},"replica_refs":{"$ref":"#/$defs/IdArray"},"predecessor_scope_commitment":{"oneOf":[{"$ref":"#/$defs/Digest"},{"type":"null"}]}}},
    "ScopeCommit": {"type":"object","additionalProperties":false,"required":["case_id","scope_version","obligation_version","scope_commitment","obligation_commitment","no_applicable_obligations"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"scope_version":{"type":"integer","minimum":1},"obligation_version":{"type":"integer","minimum":1},"scope_commitment":{"$ref":"#/$defs/Digest"},"obligation_commitment":{"$ref":"#/$defs/Digest"},"no_applicable_obligations":{"type":"boolean"}}},
    "LineageDisclose": {"type":"object","additionalProperties":false,"required":["case_id","relationship_refs","disclosure_evidence_refs","disclosed_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"relationship_refs":{"$ref":"#/$defs/IdArray"},"disclosure_evidence_refs":{"$ref":"#/$defs/IdArray"},"disclosed_at":{"$ref":"#/$defs/Timestamp"}}},
    "Obligation": {"type":"object","additionalProperties":false,"required":["obligation_id","asset_id","replica_id","repository_id","custodian_principal_id","deadline","minimum_grade","permitted_dispositions"],"properties":{"obligation_id":{"$ref":"#/$defs/Id"},"asset_id":{"$ref":"#/$defs/Id"},"replica_id":{"$ref":"#/$defs/Id"},"repository_id":{"$ref":"#/$defs/Id"},"custodian_principal_id":{"$ref":"#/$defs/Id"},"deadline":{"$ref":"#/$defs/Timestamp"},"minimum_grade":{"$ref":"#/$defs/Grade"},"permitted_dispositions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["ERASED","CRYPTO_ERASED","APPROVED_TRANSFORM"]}}}},
    "ObligationAssign": {"type":"object","additionalProperties":false,"required":["case_id","scope_version","obligation_version","obligations"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"scope_version":{"type":"integer","minimum":1},"obligation_version":{"type":"integer","minimum":1},"obligations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Obligation"}}}},
    "ErasureCommand": {"type":"object","additionalProperties":false,"required":["case_id","obligation_refs","command_commitment","issued_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"obligation_refs":{"$ref":"#/$defs/IdArray"},"command_commitment":{"$ref":"#/$defs/Digest"},"issued_at":{"$ref":"#/$defs/Timestamp"}}},
    "TerminalReceipt": {"type":"object","additionalProperties":false,"required":["case_id","obligation_id","asset_id","replica_id","repository_id","disposition","event_time","receipt_type","payload_commitment","provenance_refs"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"obligation_id":{"$ref":"#/$defs/Id"},"asset_id":{"$ref":"#/$defs/Id"},"replica_id":{"$ref":"#/$defs/Id"},"repository_id":{"$ref":"#/$defs/Id"},"disposition":{"$ref":"#/$defs/Disposition"},"event_time":{"$ref":"#/$defs/Timestamp"},"receipt_type":{"enum":["digest","hmac","signature","inclusion_proof","deletion_acknowledgement","replica_attestation","audit_finding","merkle_anchor","notification_receipt"]},"payload_commitment":{"$ref":"#/$defs/Digest"},"provenance_refs":{"$ref":"#/$defs/IdArray"}}},
    "ExceptionAssert": {"type":"object","additionalProperties":false,"required":["case_id","exception_id","obligation_refs","basis_commitment","effective_at","expires_at","evidence_refs"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"exception_id":{"$ref":"#/$defs/Id"},"obligation_refs":{"$ref":"#/$defs/IdArray"},"basis_commitment":{"$ref":"#/$defs/Digest"},"effective_at":{"$ref":"#/$defs/Timestamp"},"expires_at":{"$ref":"#/$defs/Timestamp"},"evidence_refs":{"$ref":"#/$defs/IdArray"}}},
    "EvidenceAnchor": {"type":"object","additionalProperties":false,"required":["case_id","anchor_id","evidence_refs","anchor_time","log_sequence","root_commitment"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"anchor_id":{"$ref":"#/$defs/Id"},"evidence_refs":{"$ref":"#/$defs/IdArray"},"anchor_time":{"$ref":"#/$defs/Timestamp"},"log_sequence":{"type":"integer","minimum":0},"root_commitment":{"$ref":"#/$defs/Digest"}}},
    "ViewCommit": {"type":"object","additionalProperties":false,"required":["case_id","scope_version","projection_profile_id","view_commitment","record_count"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"scope_version":{"type":"integer","minimum":1},"projection_profile_id":{"$ref":"#/$defs/Id"},"view_commitment":{"$ref":"#/$defs/Digest"},"record_count":{"type":"integer","minimum":0}}},
    "ChallengeOpen": {"type":"object","additionalProperties":false,"required":["case_id","challenge_id","challenge_kind","target_ref","grounds_commitment","opened_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"challenge_id":{"$ref":"#/$defs/Id"},"challenge_kind":{"enum":["SCOPE","AUTHORITY","EXCEPTION","EVIDENCE","DEADLINE","OTHER"]},"target_ref":{"$ref":"#/$defs/Id"},"grounds_commitment":{"$ref":"#/$defs/Digest"},"opened_at":{"$ref":"#/$defs/Timestamp"}}},
    "ChallengeResolve": {"type":"object","additionalProperties":false,"required":["case_id","challenge_id","resolution","evidence_refs","reason_codes","resolved_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"challenge_id":{"$ref":"#/$defs/Id"},"resolution":{"enum":["UPHELD","REJECTED","SUPERSEDED"]},"evidence_refs":{"$ref":"#/$defs/IdArray"},"reason_codes":{"$ref":"#/$defs/IdArray"},"resolved_at":{"$ref":"#/$defs/Timestamp"}}},
    "ClosureQuery": {"type":"object","additionalProperties":false,"required":["case_id","query_id","evaluation_time","scope_version","obligation_version"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"query_id":{"$ref":"#/$defs/Id"},"evaluation_time":{"$ref":"#/$defs/Timestamp"},"scope_version":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},"obligation_version":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]}}},
    "ClosureDecision": {"type":"object","additionalProperties":false,"required":["case_id","query_id","outcome","evaluation_time","scope_version","obligation_version","policy_profile_ref","considered_obligation_refs","reason_codes","decision_commitment"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"query_id":{"$ref":"#/$defs/Id"},"outcome":{"$ref":"#/$defs/Outcome"},"evaluation_time":{"$ref":"#/$defs/Timestamp"},"scope_version":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},"obligation_version":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},"policy_profile_ref":{"$ref":"#/$defs/Id"},"considered_obligation_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"reason_codes":{"$ref":"#/$defs/IdArray"},"decision_commitment":{"$ref":"#/$defs/Digest"}}},
    "EvidenceValidation": {"type":"object","additionalProperties":false,"required":["case_id","evidence_id","obligation_id","status","grade","rejection_code","verified_capabilities","validated_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"evidence_id":{"$ref":"#/$defs/Id"},"obligation_id":{"$ref":"#/$defs/Id"},"status":{"enum":["GRADED","REJECTED"]},"grade":{"oneOf":[{"$ref":"#/$defs/Grade"},{"type":"null"}]},"rejection_code":{"oneOf":[{"type":"string"},{"type":"null"}]},"verified_capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["record","assertion","authentication","binding","integrity","ordering","mechanism","corroboration"]}},"validated_at":{"$ref":"#/$defs/Timestamp"}}},
    "DisputeOpen": {"type":"object","additionalProperties":false,"required":["case_id","dispute_id","conflict_class","evidence_refs","challenge_refs","opened_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"dispute_id":{"$ref":"#/$defs/Id"},"conflict_class":{"enum":["DISPOSITION","TARGET","ISSUER","ORDERING","EQUIVOCATION","OTHER"]},"evidence_refs":{"$ref":"#/$defs/IdArray"},"challenge_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"opened_at":{"$ref":"#/$defs/Timestamp"}}},
    "DisputeResolve": {"type":"object","additionalProperties":false,"required":["case_id","dispute_id","accepted_evidence_refs","rejected_evidence_refs","reason_codes","resolved_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"dispute_id":{"$ref":"#/$defs/Id"},"accepted_evidence_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"rejected_evidence_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"reason_codes":{"$ref":"#/$defs/IdArray"},"resolved_at":{"$ref":"#/$defs/Timestamp"}}},
    "ExceptionDecision": {"type":"object","additionalProperties":false,"required":["case_id","exception_id","decision","reason_codes","decided_at"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"exception_id":{"$ref":"#/$defs/Id"},"decision":{"enum":["ACCEPTED","REJECTED"]},"reason_codes":{"$ref":"#/$defs/IdArray"},"decided_at":{"$ref":"#/$defs/Timestamp"}}},
    "AuditQuery": {"type":"object","additionalProperties":false,"required":["case_id","query_id","as_of","selectors","projection_profile_id"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"query_id":{"$ref":"#/$defs/Id"},"as_of":{"$ref":"#/$defs/Timestamp"},"selectors":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["CASE_BASELINE","SCOPE","OBLIGATIONS","EVIDENCE","EXCEPTIONS","CHALLENGES","DISPUTES","DECISIONS","AVAILABILITY"]}},"projection_profile_id":{"$ref":"#/$defs/Id"}}},
    "AuditResponse": {"type":"object","additionalProperties":false,"required":["case_id","query_id","projection_profile_id","record_refs","response_commitment","responded_at","next_cursor"],"properties":{"case_id":{"$ref":"#/$defs/Id"},"query_id":{"$ref":"#/$defs/Id"},"projection_profile_id":{"$ref":"#/$defs/Id"},"record_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"response_commitment":{"$ref":"#/$defs/Digest"},"responded_at":{"$ref":"#/$defs/Timestamp"},"next_cursor":{"oneOf":[{"type":"string","minLength":1},{"type":"null"}]}}}
  }
}
