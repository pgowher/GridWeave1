{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pae.local/schema/paebench-sealed-case/v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "case_id", "source_family_id", "source_variant_id", "domain", "subject_namespace", "split", "source_profile_sha256", "source_dispositions", "hidden_world_copy", "closure_ground_truth", "observer_sha256"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^unit-[a-f0-9]{16}$"},
    "case_id": {"type": "string"},
    "source_family_id": {"type": "string"},
    "source_variant_id": {"type": "string"},
    "domain": {"type": "string"},
    "subject_namespace": {"type": "string"},
    "split": {"enum": ["train", "development", "test"]},
    "source_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_dispositions": {"type": "array", "minItems": 1},
    "hidden_world_copy": {"type": "boolean"},
    "closure_ground_truth": {"type": "object", "required": ["outcome", "reason_codes", "baseline_status", "obligations", "receipt_truth"]},
    "observer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
