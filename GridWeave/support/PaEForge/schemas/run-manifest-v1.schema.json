{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paeforge.local/schema/run-manifest/v1",
  "title": "PaEForge reproducible run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "pipeline_version", "run_id", "status", "started_at", "finished_at"],
  "properties": {
    "schema_id": {"const": "https://paeforge.local/schema/run-manifest/v1"},
    "schema_version": {"const": "1.0.0"},
    "pipeline_version": {"const": "1.0.0"},
    "contract_version": {"const": "1.0.0"},
    "model_version": {"const": "PAE-FECM-v1.0.0"},
    "run_id": {"$ref": "#/$defs/Identifier"},
    "status": {"enum": ["COMPLETED", "FAILED"]},
    "started_at": {"$ref": "#/$defs/Timestamp"},
    "finished_at": {"$ref": "#/$defs/Timestamp"},
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "source_path"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/Digest"}, "source_path": {"type": "string"}}
    },
    "configuration_sha256": {"$ref": "#/$defs/Digest"},
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["paegen", "verclo", "paeforge"],
      "properties": {"paegen": {"$ref": "#/$defs/Source"}, "verclo": {"$ref": "#/$defs/Source"}, "paeforge": {"$ref": "#/$defs/Source"}}
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["derivation", "replicate_id", "master_seed_commitment", "seed_stream_digest"],
      "properties": {"derivation": {"const": "NAMED_STREAM_SHA256_V1"}, "replicate_id": {"type": "integer", "minimum": 0}, "master_seed_commitment": {"$ref": "#/$defs/Digest"}, "seed_stream_digest": {"$ref": "#/$defs/Digest"}}
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "variant_id", "observer_profile_id", "case_id", "exchange_id"],
      "properties": {"scenario_id": {"$ref": "#/$defs/Identifier"}, "variant_id": {"$ref": "#/$defs/Identifier"}, "observer_profile_id": {"$ref": "#/$defs/Identifier"}, "case_id": {"$ref": "#/$defs/Identifier"}, "exchange_id": {"$ref": "#/$defs/Identifier"}}
    },
    "stage_order": {"type": "array", "items": {"$ref": "#/$defs/Identifier"}, "minItems": 1, "uniqueItems": true},
    "oracle_isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["verclo_subprocess", "paegen_source_on_worker_pythonpath", "truth_materialized_after_result_freeze"],
      "properties": {"verclo_subprocess": {"const": true}, "paegen_source_on_worker_pythonpath": {"const": false}, "truth_materialized_after_result_freeze": {"const": true}}
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["verclo_result", "evaluation_report", "metrics", "structured_log", "classification"],
      "properties": {"verclo_result": {"type": "string"}, "evaluation_report": {"type": "string"}, "metrics": {"type": "string"}, "structured_log": {"type": "string"}, "classification": {"enum": ["MATCH", "MISMATCH", "NOT_FINAL"]}}
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_point", "command_template", "output_series"],
      "properties": {"entry_point": {"const": "PaEForge/run.py"}, "command_template": {"type": "string", "minLength": 1}, "output_series": {"const": "v1"}}
    },
    "artifact_inventory": {"type": "array", "items": {"$ref": "#/$defs/Artifact"}},
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {"type": {"$ref": "#/$defs/Identifier"}, "message": {"type": "string"}}
    },
    "structured_log": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETED"}}},
      "then": {"required": ["contract_version", "model_version", "configuration", "sources", "seed", "selection", "stage_order", "oracle_isolation", "results", "reproduction", "artifact_inventory"]},
      "else": {"required": ["configuration_sha256", "error", "structured_log"]}
    }
  ],
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Timestamp": {"type": "string", "format": "date-time"},
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["git_head", "tree_sha256", "source_revision"],
      "properties": {"git_head": {"type": ["string", "null"]}, "tree_sha256": {"$ref": "#/$defs/Digest"}, "source_revision": {"$ref": "#/$defs/Identifier"}}
    },
    "Artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "schema_id"],
      "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/Digest"}, "schema_id": {"type": ["string", "null"]}}
    }
  }
}
