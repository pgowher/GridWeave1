{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pae.local/schema/paegen-observer-bundle/v1",
  "$comment": "Sanitized VERCLO input wrapper. It deliberately cannot represent closure ground truth.",
  "title": "PaEGen observer projection bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interface_version", "model_version", "run_id", "scenario_id", "replicate_id", "config_sha256", "observer_profile_id", "access_class", "record_schema_profile_id", "record_count", "record_digest", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "interface_version": {"const": "1.0.0"},
    "model_version": {"const": "PAE-FECM-v1.0.0"},
    "run_id": {"type": "string", "minLength": 1}, "scenario_id": {"type": "string", "minLength": 1},
    "replicate_id": {"type": "integer", "minimum": 0},
    "config_sha256": {"$ref": "#/$defs/Digest"}, "observer_profile_id": {"type": "string", "minLength": 1},
    "access_class": {"enum": ["public", "restricted"]}, "record_schema_profile_id": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 0}, "record_digest": {"$ref": "#/$defs/Digest"},
    "records": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {"Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
