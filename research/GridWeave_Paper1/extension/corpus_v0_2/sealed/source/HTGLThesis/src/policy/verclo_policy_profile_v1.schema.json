{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pae.local/schema/verclo-policy-profile/v1",
  "title": "VERCLO modular policy profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_version", "profile_id", "version", "authorization_basis", "applicable_asset_kinds", "applicable_replica_classes", "default_rule", "overrides", "exception_authority_ids", "early_closure_allowed"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_version": {"const": "PAE-FECM-v1.0.0"},
    "profile_id": {"type": "string", "pattern": "^VERCLO-POLICY-[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authorization_basis": {"type": "string", "minLength": 3},
    "applicable_asset_kinds": {"$ref": "#/$defs/StringSet"},
    "applicable_replica_classes": {"$ref": "#/$defs/StringSet"},
    "default_rule": {"$ref": "#/$defs/Rule"},
    "overrides": {"type": "array", "items": {"$ref": "#/$defs/Override"}},
    "exception_authority_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "early_closure_allowed": {"type": "boolean"}
  },
  "$defs": {
    "StringSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "Rule": {
      "type": "object", "additionalProperties": false,
      "required": ["deadline_hours", "minimum_evidence_grade", "permitted_dispositions"],
      "properties": {
        "deadline_hours": {"type": "integer", "minimum": 1},
        "minimum_evidence_grade": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
        "permitted_dispositions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ERASED", "CRYPTO_ERASED", "APPROVED_TRANSFORM"]}}
      }
    },
    "Override": {
      "type": "object", "additionalProperties": false,
      "required": ["override_id", "asset_kinds", "replica_classes", "rule"],
      "properties": {
        "override_id": {"type": "string", "minLength": 3},
        "asset_kinds": {"$ref": "#/$defs/StringSet"},
        "replica_classes": {"$ref": "#/$defs/StringSet"},
        "rule": {"$ref": "#/$defs/Rule"}
      }
    }
  }
}
